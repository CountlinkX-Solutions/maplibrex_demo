// This file is needed on most editors to enable the intelligent autocompletion
// of LiveView's JavaScript API methods. You can safely delete it if you don't need it.
//
// The paths below point editors at the Phoenix packages in deps/, the same
// place esbuild finds them through NODE_PATH.
//
// esbuild reads this file too, and applies "paths" before it looks in
// node_modules. Do not add a catch-all such as "*": ["../deps/*"]: it would
// send `import "maplibrex"` to whatever deps/maplibrex holds, even when
// MAPLIBREX_PATH points the demo at another checkout. MaplibreX is resolved
// through assets/node_modules/maplibrex instead (see config/config.exs).
{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "phoenix": ["../deps/phoenix"],
      "phoenix_html": ["../deps/phoenix_html"],
      "phoenix_live_view": ["../deps/phoenix_live_view"]
    },
    "allowJs": true,
    "noEmit": true
  },
  "include": ["js/**/*"]
}
