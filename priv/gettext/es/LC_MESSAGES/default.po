## -- Demo card descriptions --

msgid "Draggable markers, GeoJSON layers, real-time style switching"
msgstr "Marcadores arrastrables, capas GeoJSON, cambio de estilos en tiempo real"

msgid "Vector tile rendering from a local server (localhost:4000) with PostgreSQL"
msgstr "Renderizado de tiles vectoriales desde servidor local (localhost:4000) con PostgreSQL"

msgid "OGC API Features conformance with real geographic data from your own server"
msgstr "Conformidad OGC API Features con datos geográficos reales desde el servidor propio"

msgid "3D ArcLayer, HexagonLayer density and ScatterplotLayer with integrated deck.gl"
msgstr "ArcLayer 3D, HexagonLayer de densidad y ScatterplotLayer con deck.gl integrado"

msgid "Elevation rendering with DEM sources, hillshade and extruded terrain up to 3x"
msgstr "Renderizado de elevación con fuentes DEM, hillshade y terreno extruido hasta 3x"

msgid "500 seismic points on a heatmap with adjustable radius, intensity and opacity"
msgstr "500 puntos sísmicos en mapa de calor con radio, intensidad y opacidad ajustables"

msgid "Extruded New York buildings with configurable color schemes and height"
msgstr "Edificios extruados de Nueva York con esquemas de color y altura configurables"

msgid "Category markers with real-time filtering and drag to update coordinates"
msgstr "Marcadores por categoría con filtrado en tiempo real y arrastre para actualizar coords"

msgid "System of 1,000 animated particles with custom GLSL shaders (vertex + fragment)"
msgstr "Sistema de 1.000 partículas animadas con shaders GLSL propios (vertex + fragment)"

