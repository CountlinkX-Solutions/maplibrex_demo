<div id="buildings-scenario">
  <.example_frame error={@map_error} error_id="scenario-buildings-map-error" tall>
    <.map
      id="scenario-buildings-map"
      center={@center}
      zoom={14.6}
      pitch={60}
      bearing={-17.6}
      style={basemap(@theme)}
      class="h-full w-full"
    />
  </.example_frame>

  <.navigation_control
    id="scenario-buildings-navigation"
    map_id="scenario-buildings-map"
    visualize_pitch
  />

  <.geojson_layer
    id="scenario-buildings-layer"
    map_id="scenario-buildings-map"
    type="fill-extrusion"
    data={@blocks}
    paint={paint(@color_scheme, @height_scale, @opacity)}
  />

  <div class="grid gap-x-8 gap-y-4 border-t border-line px-4 py-4 lg:grid-cols-[auto_1fr]">
    <.example_group id="scenario-buildings-schemes" label="color_scheme" code>
      <.example_button
        :for={scheme <- schemes()}
        id={"scenario-buildings-scheme-#{scheme}"}
        code
        pressed={@color_scheme == scheme}
        phx-click="scheme"
        phx-value-scheme={scheme}
      >
        {scheme}
      </.example_button>
    </.example_group>

    <.example_group id="scenario-buildings-assigns" label={gettext("Set assigns")}>
      <.form
        for={@options}
        id="scenario-buildings-options"
        phx-change="options"
        class="grid w-full gap-4 sm:max-w-lg sm:grid-cols-2"
      >
        <.example_range
          field={@options[:height_scale]}
          label="height_scale"
          min="0.5"
          max="3"
          step="0.1"
        />
        <.example_range field={@options[:opacity]} label="opacity" min="0.3" max="1" step="0.05" />
      </.form>
    </.example_group>
  </div>

  <div class="px-4 pb-4">
    <.example_note id="scenario-buildings-sample-data">
      {gettext(
        "Sample data: a synthetic grid of 225 blocks with generated heights and types, placed over lower Manhattan for scale. They are not the real buildings. Click one."
      )}
    </.example_note>
  </div>

  <%!-- layer:feature_clicked sets selected. --%>
  <.example_readout values={[
    blocks: length(@blocks["features"]),
    color_scheme: @color_scheme,
    height_scale: @height_scale,
    opacity: @opacity,
    selected: @selected || "—"
  ]} />
</div>
