<div id="control-group-example">
  <.example_frame error={@map_error} error_id="example-control-group-map-error">
    <.map
      id="example-control-group-map"
      center={[-99.1332, 19.4326]}
      zoom={@zoom}
      style="https://tiles.openfreemap.org/styles/liberty"
      class="h-full w-full"
    />
  </.example_frame>

  <%!-- The group's content is plain buttons, drawn as one control. A
        <.control_button> placed here would be added to the map as a
        control of its own instead. --%>
  <.control_group
    id="example-control-group"
    map_id="example-control-group-map"
    position="top-left"
  >
    <button
      :for={level <- levels()}
      id={"example-control-group-#{level.id}"}
      type="button"
      title={label(level.id)}
      aria-label={label(level.id)}
      aria-pressed={to_string(@zoom == level.zoom)}
      class={["grid! place-items-center", @zoom == level.zoom && "maplibregl-ctrl-active"]}
      phx-click="zoom"
      phx-value-level={level.id}
    >
      <.icon name={level.icon} class="size-5" />
    </button>
  </.control_group>

  <div class="border-t border-line px-4 py-4">
    <.example_note id="example-control-group-hint" icon="hero-cursor-arrow-rays-micro">
      {gettext(
        "Use the three buttons in the map's top-left corner, or zoom the map yourself: map:moved keeps the zoom assign current."
      )}
    </.example_note>
  </div>

  <.example_readout values={[zoom: @zoom]} />
</div>
