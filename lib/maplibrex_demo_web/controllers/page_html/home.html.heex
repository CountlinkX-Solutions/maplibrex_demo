<Layouts.flash_group flash={@flash} />

<%!-- Ambient background orbs --%>
<div aria-hidden="true" class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
  <div class="absolute -top-[15%] -left-[10%] h-[600px] w-[600px] animate-[orb-pulse_8s_ease-in-out_infinite] rounded-full bg-[radial-gradient(circle,rgba(34,211,238,0.10)_0%,transparent_70%)]" />
  <div class="absolute -right-[8%] -bottom-[20%] h-[700px] w-[700px] animate-[orb-pulse_10s_ease-in-out_infinite_2s] rounded-full bg-[radial-gradient(circle,rgba(99,102,241,0.10)_0%,transparent_70%)]" />
</div>

<div class="relative z-10 flex min-h-screen flex-col">
  <%!-- Navbar --%>
  <nav class="flex items-center justify-between border-b border-white/[0.06] px-8 py-5">
    <span class="text-[1.05rem] font-bold tracking-tight text-white/95">
      Maplibre<span class="text-cyan-400">X</span>
    </span>

    <div class="flex items-center gap-6">
      <span class="hidden font-mono text-[0.7rem] tracking-[0.08em] text-white/30 sm:inline">
        Phoenix LiveView × MapLibre GL
      </span>

      <div class="flex items-center gap-1.5 rounded-full border border-white/[0.08] bg-white/[0.04] px-2.5 py-1">
        <.locale_toggle locale="en" current={@locale} />
        <span class="text-[0.65rem] text-white/15">|</span>
        <.locale_toggle locale="es" current={@locale} />
      </div>
    </div>
  </nav>

  <%!-- Hero --%>
  <div class="flex flex-col items-center px-6 pt-20 pb-12 text-center">
    <div class="animate-[fade-up_0.6s_cubic-bezier(0.22,1,0.36,1)_0.05s_both] mb-5">
      <span class="inline-block rounded-full border border-cyan-400/30 bg-cyan-400/[0.06] px-3.5 py-1.5 text-[0.7rem] font-semibold tracking-[0.12em] text-cyan-400/85 uppercase">
        {gettext("Component Library · v0.1")}
      </span>
    </div>

    <h1 class="animate-[fade-up_0.6s_cubic-bezier(0.22,1,0.36,1)_0.15s_both] mb-5 max-w-[700px] text-[clamp(2rem,5vw,3.5rem)] leading-[1.1] font-extrabold tracking-[-0.03em] text-white/95">
      {gettext("Interactive Maps")}<br />
      <span class="bg-gradient-to-br from-cyan-400 to-indigo-400 bg-clip-text text-transparent">
        {gettext("for Phoenix LiveView")}
      </span>
    </h1>

    <p class="animate-[fade-up_0.6s_cubic-bezier(0.22,1,0.36,1)_0.25s_both] mb-10 max-w-[520px] text-[1.05rem] leading-relaxed text-white/50">
      {gettext(
        "MaplibreX wraps MapLibre GL JS as native LiveView components. Real-time maps, zero custom JavaScript."
      )}
    </p>

    <div class="animate-[fade-up_0.6s_cubic-bezier(0.22,1,0.36,1)_0.35s_both] flex flex-wrap justify-center gap-3">
      <a
        href="#demos"
        class="inline-flex items-center gap-2 rounded-full bg-gradient-to-br from-cyan-400/90 to-indigo-500/90 px-6 py-2.5 text-sm font-bold text-[#050810] no-underline transition-opacity duration-200 hover:opacity-85"
      >
        {gettext("Explore Demos")}
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M7 17L17 7M17 7H7M17 7v10" />
        </svg>
      </a>

      <a
        href="https://github.com/CountlinkX-Solutions/maplibrex"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-white/[0.12] bg-white/[0.04] px-6 py-2.5 text-sm font-medium text-white/75 no-underline transition-colors duration-200 hover:border-white/20 hover:bg-white/[0.08]"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.506 0 12.303c0 5.445 3.435 10.043 8.205 11.674.6.107.825-.262.825-.585 0-.292-.015-1.261-.015-2.291C6 21.67 5.22 20.346 4.98 19.654c-.135-.354-.72-1.446-1.23-1.738-.42-.23-1.02-.8-.015-.815.945-.015 1.62.892 1.845 1.261 1.08 1.86 2.805 1.338 3.495 1.015.105-.8.42-1.338.765-1.645-2.67-.308-5.46-1.37-5.46-6.075 0-1.338.465-2.446 1.23-3.307-.12-.308-.54-1.569.12-3.26 0 0 1.005-.323 3.3 1.26.96-.276 1.98-.415 3-.415s2.04.139 3 .416c2.295-1.6 3.3-1.261 3.3-1.261.66 1.691.24 2.952.12 3.26.765.861 1.23 1.953 1.23 3.307 0 4.721-2.805 5.767-5.475 6.075.435.384.81 1.122.81 2.276 0 1.645-.015 2.968-.015 3.383 0 .323.225.707.825.585a12.047 12.047 0 0 0 5.919-4.489A12.536 12.536 0 0 0 24 12.304C24 5.505 18.63 0 12 0Z" />
        </svg>
        GitHub
      </a>
    </div>
  </div>

  <%!-- Stats --%>
  <div class="mb-16 flex justify-center px-6">
    <div class="flex flex-wrap justify-center overflow-hidden rounded-2xl border border-white/[0.07] bg-white/[0.03]">
      <div
        :for={{label, value} <- @stats}
        class="border-r border-white/[0.06] px-7 py-4 text-center last:border-r-0"
      >
        <div class="font-mono text-xl leading-none font-bold text-cyan-400">{value}</div>
        <div class="mt-1.5 text-[0.7rem] tracking-[0.05em] text-white/35">{label}</div>
      </div>
    </div>
  </div>

  <%!-- Demo grid --%>
  <div id="demos" class="mx-auto w-full max-w-[1100px] px-8 pb-20">
    <div class="mb-10">
      <p class="mb-2 text-[0.65rem] font-semibold tracking-[0.15em] text-white/30 uppercase">
        {gettext("Interactive demos")}
      </p>
      <h2 class="text-2xl font-bold tracking-[-0.02em] text-white/90">
        {gettext("Explore the capabilities")}
      </h2>
    </div>

    <div class="grid grid-cols-[repeat(auto-fill,minmax(300px,1fr))] gap-4">
      <a
        :for={demo <- @demos}
        href={demo.path}
        class="group block rounded-[1.125rem] bg-white/[0.04] p-px no-underline transition-[transform,box-shadow] duration-[250ms] ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-[3px] hover:shadow-[0_0_0_1px_rgba(34,211,238,0.3),0_12px_40px_rgba(0,0,0,0.4)]"
      >
        <div class="flex h-full flex-col gap-4 rounded-2xl border border-white/[0.07] bg-[rgba(8,12,28,0.9)] p-6 transition-colors duration-[250ms] group-hover:border-cyan-400/20">
          <div class="flex items-start justify-between gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[0.625rem] border border-cyan-400/[0.12] bg-cyan-400/[0.08]">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="rgba(34,211,238,0.8)"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d={demo.icon} />
              </svg>
            </div>

            <span class="rounded-full border border-cyan-400/[0.12] bg-cyan-400/[0.06] px-2.5 py-1 text-[0.62rem] font-semibold tracking-[0.1em] whitespace-nowrap text-cyan-400/60 uppercase">
              {demo.label}
            </span>
          </div>

          <div class="flex-1">
            <h3 class="mb-1.5 text-[0.975rem] font-bold tracking-[-0.01em] text-white/90">
              {demo.title}
            </h3>
            <p class="text-[0.8rem] leading-relaxed text-white/45">{demo.desc}</p>
          </div>

          <div class="flex items-center justify-end">
            <span class="text-xs font-semibold text-white/30 transition-[transform,color] duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-cyan-400/90">
              {gettext("Open demo →")}
            </span>
          </div>
        </div>
      </a>
    </div>
  </div>

  <%!-- Footer --%>
  <footer class="mt-auto flex flex-wrap items-center justify-between gap-2 border-t border-white/[0.06] px-8 py-6">
    <span class="text-xs text-white/25">
      MaplibreX &mdash; {gettext("Built with Phoenix LiveView")}
    </span>
    <div class="flex items-center gap-4">
      <a
        href="https://hexdocs.pm/maplibrex"
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-[0.65rem] text-white/25 no-underline hover:text-white/50"
      >
        hexdocs
      </a>
      <a
        href="https://github.com/CountlinkX-Solutions/maplibrex"
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-[0.65rem] text-white/25 no-underline hover:text-white/50"
      >
        github
      </a>
    </div>
  </footer>
</div>
