<!DOCTYPE html>
<html lang={assigns[:locale] || "en"} data-theme={assigns[:theme]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="MaplibreX" suffix=" · MaplibreX">
      {assigns[:page_title]}
    </.live_title>
    <link
      rel="preload"
      href={~p"/fonts/lato-latin-400-normal.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={~p"/fonts/lato-latin-700-normal.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="module" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-canvas text-ink antialiased">
    {@inner_content}
  </body>
</html>
